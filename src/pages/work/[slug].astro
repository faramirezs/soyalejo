---
import { getEmDashEntry, getEmDashCollection, decodeSlug } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: project, cacheHint } = await getEmDashEntry("projects", slug);

if (!project) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Related projects: order by date in the DB and request a small lookahead
// so we can drop the current entry without re-querying. Avoids loading
// every project just to slice off two.
const { entries: relatedProjects, cacheHint: relatedProjectsCacheHint } =
	await getEmDashCollection("projects", {
		orderBy: { published_at: "desc" },
		limit: 3,
	});

if (Astro.cache?.enabled) Astro.cache.set(relatedProjectsCacheHint);

const otherProjects = relatedProjects.filter((p) => p.id !== project.id).slice(0, 2);

// Parse gallery if present
const gallery = project.data.gallery as
	| Array<{ url: string; alt?: string }>
	| undefined;

// Get image src for OG image
function getImageSrc(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	return typeof image.src === "string" ? image.src : undefined;
}
---

<Base
	title={project.data.title}
	description={project.data.summary}
	image={getImageSrc(project.data.featured_image)}
	variant="paper"
>
	<article class="project">
		<nav class="project-breadcrumb" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">»</span>
			<a href="/work">Case studies</a>
			<span aria-hidden="true">»</span>
			<span>{project.data.client || "Case study"}</span>
		</nav>
		<header class="project-header">
			<div class="project-meta">
				{
					project.data.client && (
						<span class="project-client" {...project.edit.client}>
							{project.data.client}
						</span>
					)
				}
				{
					project.data.client && project.data.year && (
						<span class="meta-separator">·</span>
					)
				}
				{
					project.data.year && (
						<span class="project-year" {...project.edit.year}>
							{project.data.year}
						</span>
					)
				}
			</div>
			<h1 class="project-title" {...project.edit.title}>
				{project.data.title}
			</h1>
			{
				project.data.summary && (
					<p class="project-summary" {...project.edit.summary}>
						{project.data.summary}
					</p>
				)
			}
			{
				project.data.url && (
					<a
						href={project.data.url ?? "#"}
						class="project-link"
						target="_blank"
						rel="noopener noreferrer"
					>
						Open public reference →
					</a>
				)
			}
		</header>

		{
			project.data.featured_image && (
				<div class="featured-image" {...project.edit.featured_image}>
					<Image image={project.data.featured_image} />
				</div>
			)
		}

		<div class="project-content">
			<PortableText value={project.data.content} />
		</div>

		{
			gallery && gallery.length > 0 && (
				<div class="project-gallery">
					{gallery.map((img) => (
						<figure class="gallery-item">
							<img src={img.url} alt={img.alt || ""} loading="lazy" />
							{img.alt && <figcaption>{img.alt}</figcaption>}
						</figure>
					))}
				</div>
			)
		}
	</article>

	{
		otherProjects.length > 0 && (
			<section class="more-projects">
				<div class="more-inner">
					<h2 class="more-title">More Case Studies</h2>
					<div class="more-grid">
						{otherProjects.map((p) => (
							<ProjectCard
								title={p.data.title ?? "Untitled"}
								summary={p.data.summary}
								featuredImage={p.data.featured_image ?? ""}
								href={`/work/${p.id}`}
								client={p.data.client}
								year={p.data.year}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>

<style>
	.project {
		max-width: 52rem;
		margin: 0 auto;
		padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-4xl);
		--paper-link: var(--color-brand);
	}

	.project-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-2xl);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.project-breadcrumb a {
		color: inherit;
	}

	.project-header {
		margin-bottom: var(--spacing-2xl);
	}

	.project-meta {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-md);
	}

	.meta-separator {
		margin: 0 var(--spacing-sm);
	}

	.project-title {
		font-family: var(--font-body);
		font-size: var(--font-size-4xl);
		font-weight: 750;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-md);
	}

	.project-summary {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		line-height: var(--leading-normal);
		margin-bottom: var(--spacing-lg);
	}

	.project-link {
		display: inline-block;
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--paper-link);
		text-underline-offset: 0.2em;
	}

	.project-link:hover {
		color: var(--color-text);
	}

	.featured-image {
		margin-bottom: var(--spacing-3xl);
		border-block: 1px solid var(--color-border);
		padding: var(--spacing-lg) 0;
	}

	.featured-image img {
		width: 100%;
		height: auto;
		border-radius: 0;
	}

	.project-content {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
	}

	.project-content :global(p) {
		margin-bottom: 1.75em;
	}

	.project-content :global(h2) {
		font-family: var(--font-body);
		font-size: var(--font-size-2xl);
		font-weight: 750;
		letter-spacing: var(--tracking-tight);
		margin-top: 2.75em;
		margin-bottom: 0.75em;
	}

	.project-content :global(h3) {
		font-family: var(--font-body);
		font-size: var(--font-size-xl);
		font-weight: 700;
		margin-top: 2em;
		margin-bottom: 0.5em;
	}

	.project-content :global(blockquote) {
		margin: 2em 0;
		padding-left: var(--spacing-xl);
		border-left: 2px solid var(--color-brand);
		color: var(--color-muted);
		font-family: var(--font-heading);
		font-style: italic;
		font-size: var(--font-size-lg);
	}

	.project-content :global(ul),
	.project-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 1.25em;
	}

	.project-content :global(li) {
		margin-bottom: 0.5em;
	}

	.project-content :global(img) {
		margin: 2em 0;
		border-radius: var(--radius);
	}

	.project-content :global(a) {
		color: var(--paper-link);
		text-underline-offset: 0.2em;
	}

	.project-gallery {
		margin-top: var(--spacing-3xl);
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-2xl);
		border-top: 1px solid var(--color-border);
		padding-top: var(--spacing-2xl);
	}

	.gallery-item img {
		width: 100%;
		height: auto;
		border-radius: 0;
	}

	.gallery-item figcaption {
		margin-top: var(--spacing-sm);
		font-size: var(--font-size-sm);
		line-height: var(--leading-normal);
		color: var(--color-muted);
	}

	.more-projects {
		margin-top: var(--spacing-4xl);
		border-top: 1px solid var(--color-border);
		padding-top: var(--spacing-2xl);
	}

	.more-inner {
		max-width: 52rem;
		margin: 0 auto;
		padding: 0 var(--spacing-lg);
	}

	.more-title {
		font-family: var(--font-body);
		font-size: var(--font-size-2xl);
		font-weight: 750;
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-lg);
	}

	.more-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
	}

	.more-grid :global(.project-card) {
		border-top: 1px solid var(--color-border);
		padding: var(--spacing-lg) 0;
	}

	.more-grid :global(.card-link) {
		display: block;
	}

	.more-grid :global(.card-image) {
		display: none;
	}

	.more-grid :global(.card-title) {
		font-family: var(--font-body);
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--paper-link);
	}

	.more-grid :global(.card-summary) {
		font-size: var(--font-size-base);
		line-height: var(--leading-normal);
	}

	@media (max-width: 768px) {
		.project-title {
			font-size: var(--font-size-3xl);
		}

		.project-gallery {
			grid-template-columns: 1fr;
		}

		.more-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
