---
export const prerender = false;

import {
	getEmDashCollection,
	getTaxonomyTerms,
	getTermsForEntries,
} from "emdash";
import Base from "../../layouts/Base.astro";

// Get filter from query param. When set, push the filter down to the
// database via `where` instead of loading every project and filtering
// in JS — that pattern scales O(projects × terms-per-project) and
// blows up the moment you have more than a couple of dozen entries.
const activeTag = Astro.url.searchParams.get("tag");

const [{ entries: sortedProjects, cacheHint }, tags] = await Promise.all([
	getEmDashCollection("projects", {
		orderBy: { published_at: "desc" },
		...(activeTag ? { where: { tag: activeTag } } : {}),
	}),
	getTaxonomyTerms("tag"),
]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched JOIN for the tag pills shown on each card, instead of
// one getEntryTerms() round-trip per card.
const tagsByEntry = await getTermsForEntries(
	"projects",
	sortedProjects.map((p) => p.data.id),
	"tag",
);
const projectsWithTags = sortedProjects.map((project) => ({
	project,
	projectTags: tagsByEntry.get(project.data.id) ?? [],
}));
---

<Base
	title={activeTag
		? `${tags.find((t) => t.slug === activeTag)?.label || activeTag} — Case Studies`
		: "Case Studies"}
>
	<section class="work-header">
		<h1>Case Studies</h1>
		<p class="work-intro">
			Automation, integrations, accounting systems, and open-source engineering.
		</p>

		{
			tags.length > 0 && (
				<nav class="tag-filters" aria-label="Filter by tag">
					{tags.map((tag) => (
						<a
							href={`/work?tag=${tag.slug}`}
							class:list={["tag-filter", { active: activeTag === tag.slug }]}
						>
							{tag.label}
						</a>
					))}
					{activeTag && (
						<a href="/work" class="tag-clear" aria-label="Clear filter">
							Clear
						</a>
					)}
				</nav>
			)
		}
	</section>

	{
		projectsWithTags.length > 0 ? (
			<section class="projects">
				<ul class="project-list">
					{projectsWithTags.map(({ project, projectTags }) => (
						<li class="project-list-item">
							<a href={`/work/${project.id}`} class="project-list-link">
								<h2>{project.data.title ?? "Untitled"}</h2>
								<div class="project-list-meta">
									{project.data.client && <span>{project.data.client}</span>}
									{project.data.client && project.data.year && (
										<span aria-hidden="true">·</span>
									)}
									{project.data.year && <span>{project.data.year}</span>}
								</div>
								{project.data.summary && <p>{project.data.summary}</p>}
							</a>
							{
								projectTags.length > 0 && (
									<p class="project-list-tags">
										{projectTags.map((tag) => (
											<a href={`/work?tag=${tag.slug}`}>{tag.label}</a>
										))}
									</p>
								)
							}
						</li>
					))}
				</ul>
			</section>
		) : (
			<section class="empty-state">
				{activeTag ? (
					<>
						<p>No projects found with this tag.</p>
						<a href="/work" class="btn">
							View all projects
						</a>
					</>
				) : (
					<>
						<p>No projects yet. Add your first project in the admin panel.</p>
						<a href="/_emdash/admin/content/projects/new" class="btn">
							Add a project
						</a>
					</>
				)}
			</section>
		)
	}
</Base>

<style>
	.work-header,
	.projects {
		max-width: 52rem;
		margin: 0 auto;
		padding-inline: var(--spacing-lg);
	}

	.work-header {
		padding-top: var(--spacing-2xl);
		padding-bottom: var(--spacing-2xl);
	}

	.work-header h1 {
		font-family: var(--font-body);
		font-size: var(--font-size-4xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-sm);
	}

	.work-intro {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
	}

	.tag-filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
		margin-top: var(--spacing-xl);
	}

	.tag-filter,
	.tag-clear {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		text-decoration-color: transparent;
		text-underline-offset: 0.35em;
	}

	.tag-filter:hover,
	.tag-filter.active,
	.tag-clear:hover {
		color: var(--color-brand);
		text-decoration-color: currentColor;
	}

	.projects {
		padding-bottom: var(--spacing-4xl);
	}

	.project-list {
		list-style: none;
		border-top: 1px solid var(--color-border);
	}

	.project-list-item {
		padding: var(--spacing-xl) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.project-list-link {
		display: block;
		text-decoration: none;
	}

	.project-list-link h2 {
		font-family: var(--font-body);
		font-size: var(--font-size-xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		color: var(--color-brand);
	}

	.project-list-link:hover h2 {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.project-list-meta,
	.project-list-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-sm);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.project-list-link p {
		margin-top: var(--spacing-sm);
		line-height: var(--leading-normal);
		color: var(--color-text);
	}

	.project-list-tags a {
		color: inherit;
		text-underline-offset: 0.2em;
	}

	.project-list-tags a:hover {
		color: var(--color-brand);
	}

	.empty-state {
		max-width: 52rem;
		margin: 0 auto;
		padding: var(--spacing-4xl) var(--spacing-lg);
		color: var(--color-muted);
	}

	.btn {
		display: inline-block;
		margin-top: var(--spacing-lg);
		padding: var(--spacing-sm) var(--spacing-lg);
		background: var(--color-brand);
		color: var(--color-on-brand);
		text-decoration: none;
	}

	.btn:hover {
		transform: translateY(-2px);
	}

	@media (max-width: 768px) {
		.work-header h1 {
			font-size: var(--font-size-3xl);
		}
	}
</style>
