---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "about");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="About" description="Learn more about Alejandro Ramírez, an Automation & Integrations Engineer.">
	<article class="info-page">
		<nav class="page-breadcrumb" aria-label="Breadcrumb">
			<a href="/">Home</a>
			<span aria-hidden="true">»</span>
			<span>About</span>
		</nav>
		<header class="info-header">
			<h1 class="info-title" {...page?.edit?.title}>
				{page?.data?.title || "About"}
			</h1>
		</header>

		<div class="info-content" {...page?.edit?.content}>
			{
				page?.data?.content ? (
					<PortableText value={page.data.content} />
				) : (
					<p>Content coming soon.</p>
				)
			}
		</div>
	</article>
</Base>

<style>
	.info-page {
		max-width: 52rem;
		margin: 0 auto;
		padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-4xl);
	}

	.page-breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-2xl);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.page-breadcrumb a {
		color: inherit;
	}

	.info-title {
		font-family: var(--font-body);
		font-size: var(--font-size-4xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin-bottom: var(--spacing-2xl);
	}

	.info-content {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
	}

	.info-content :global(p) {
		margin-bottom: 1.75em;
	}

	.info-content :global(h2) {
		font-family: var(--font-body);
		font-size: var(--font-size-2xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin: 2.75em 0 0.75em;
	}

	.info-content :global(h3) {
		font-family: var(--font-body);
		font-size: var(--font-size-xl);
		font-weight: 700;
		margin: 2em 0 0.5em;
	}

	.info-content :global(ul),
	.info-content :global(ol) {
		margin: 0 0 1.75em;
		padding-left: 1.25em;
	}

	.info-content :global(li) {
		margin-bottom: var(--spacing-sm);
	}

	.info-content :global(a) {
		color: var(--color-brand);
		text-underline-offset: 0.2em;
	}

	@media (max-width: 768px) {
		.info-page {
			padding-top: var(--spacing-xl);
		}

		.info-title {
			font-size: var(--font-size-3xl);
		}
	}
</style>
