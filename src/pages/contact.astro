---
import Base from "../layouts/Base.astro";
---

<Base
	title="Contact"
	description="Contact Alejandro Ramírez about automation, integration, and internal-tools engineering work."
>
	<div class="contact-page">
		<header class="contact-header">
			<h1 class="contact-title">Build the awkward integration.</h1>
			<p class="contact-intro">
				I am interested in Automation &amp; Integrations Engineer, Business Systems Engineer,
				Internal Tools Engineer, and Backend &amp; Integrations Engineer roles.
			</p>
			<a class="contact-cta" href="mailto:faramirezs@gmail.com">Email Alejandro →</a>
		</header>

		<aside class="contact-info" aria-label="Contact details">
			<div class="info-section">
				<h2>Email</h2>
				<p><a href="mailto:faramirezs@gmail.com">faramirezs@gmail.com</a></p>
			</div>
			<div class="info-section">
				<h2>Location</h2>
				<p>Berlin, Germany</p>
			</div>
			<div class="info-section">
				<h2>Profiles</h2>
				<ul class="profile-links">
					<li>
						<a href="https://github.com/faramirezs" target="_blank" rel="noopener noreferrer">GitHub</a>
					</li>
					<li>
						<a href="https://www.linkedin.com/in/alejandro-mlops-engineer/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					</li>
				</ul>
			</div>
		</aside>
	</div>
</Base>

<style>
	.contact-page {
		max-width: 52rem;
		margin: 0 auto;
		padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-4xl);
	}

	.contact-header {
		padding-bottom: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.contact-title {
		font-family: var(--font-body);
		font-size: var(--font-size-4xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin-bottom: var(--spacing-lg);
	}

	.contact-intro {
		font-size: var(--font-size-lg);
		line-height: var(--leading-normal);
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}

	.contact-cta {
		font-weight: 700;
		color: var(--color-brand);
		text-underline-offset: 0.2em;
	}

	.contact-info {
		margin-top: var(--spacing-2xl);
		border-top: 1px solid var(--color-border);
	}

	.info-section {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: var(--spacing-lg);
		padding: var(--spacing-lg) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.info-section h2 {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		font-weight: 700;
	}

	.info-section p,
	.info-section a,
	.profile-links {
		font-size: var(--font-size-base);
		color: var(--color-muted);
	}

	.info-section a {
		color: var(--color-brand);
		text-underline-offset: 0.2em;
	}

	.profile-links {
		list-style: none;
		display: flex;
		gap: var(--spacing-lg);
	}

	@media (max-width: 768px) {
		.contact-page {
			padding-top: var(--spacing-xl);
		}

		.contact-title {
			font-size: var(--font-size-3xl);
		}
	}

	@media (max-width: 480px) {
		.info-section {
			grid-template-columns: 1fr;
			gap: var(--spacing-sm);
		}
	}
</style>
