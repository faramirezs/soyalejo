---
import Base from "../layouts/Base.astro";
import { markdownResponse } from "../lib/markdown";

const markdown = `# Contact Alejandro Ramírez

Alejandro Ramírez is an Automation and Integrations Engineer in Berlin. Contact him about Automation and Integrations Engineer, Business Systems Engineer, Internal Tools Engineer, and Backend and Integrations Engineer roles.

He is most useful when a team needs to connect systems, remove repeated operational work, make accounting or document processes safer, build an internal tool, or improve an API and data workflow. He works from diagnosis through design, implementation, verification, and handoff. The relevant technical evidence is available in the portfolio tutorials.

Email [faramirezs@gmail.com](mailto:faramirezs@gmail.com) with the operating problem, systems involved, team context, and expected outcome. This makes it easier to identify whether the work is a good fit. GitHub and LinkedIn are also available for public professional references.

Location: Berlin, Germany.
`;

const markdownPage = Astro.locals.prefersMarkdown ? markdownResponse(markdown) : null;
if (markdownPage) return markdownPage;
---

<Base
	title="Contact"
	description="Contact Alejandro Ramírez about automation, integration, and internal-tools engineering work."
>
	<div class="contact-page">
		<header class="contact-header">
			<h1 class="contact-title">Build the awkward integration.</h1>
			<p class="contact-intro">
				I am interested in Automation &amp; Integrations Engineer, Business Systems Engineer,
				Internal Tools Engineer, and Backend &amp; Integrations Engineer roles.
			</p>
			<a class="contact-cta" href="mailto:faramirezs@gmail.com">Email Alejandro →</a>
		</header>

		<section class="contact-context" aria-labelledby="contact-context-title">
			<h2 id="contact-context-title">Best fit</h2>
			<p>
				I am most useful when a team needs to connect systems, remove repeated operational
				work, make accounting or document processes safer, build an internal tool, or improve
				an API and data workflow.
			</p>
			<p>
				I work from diagnosis through design, implementation, verification, and handoff. The
				technical tutorials on this site show how I approach idempotency, evidence, failure
				states, and controlled writes in production workflows.
			</p>
			<p>
				Email me with the operating problem, systems involved, team context, and expected
				outcome. This makes it easier to identify whether the work is a good fit.
			</p>
		</section>

		<aside class="contact-info" aria-label="Contact details">
			<div class="info-section">
				<h2>Email</h2>
				<p><a href="mailto:faramirezs@gmail.com">faramirezs@gmail.com</a></p>
			</div>
			<div class="info-section">
				<h2>Location</h2>
				<p>Berlin, Germany</p>
			</div>
			<div class="info-section">
				<h2>Profiles</h2>
				<ul class="profile-links">
					<li>
						<a href="https://github.com/faramirezs" target="_blank" rel="noopener noreferrer">GitHub</a>
					</li>
					<li>
						<a href="https://www.linkedin.com/in/alejandro-mlops-engineer/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					</li>
				</ul>
			</div>
		</aside>
	</div>
</Base>

<style>
	.contact-page {
		max-width: 52rem;
		margin: 0 auto;
		padding: var(--spacing-2xl) var(--spacing-lg) var(--spacing-4xl);
	}

	.contact-header {
		padding-bottom: var(--spacing-2xl);
		border-bottom: 1px solid var(--color-border);
	}

	.contact-title {
		font-family: var(--font-body);
		font-size: var(--font-size-4xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: var(--leading-tight);
		margin-bottom: var(--spacing-lg);
	}

	.contact-intro {
		font-size: var(--font-size-lg);
		line-height: var(--leading-normal);
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}

	.contact-cta {
		font-weight: 700;
		color: var(--color-brand);
		text-underline-offset: 0.2em;
	}


	.contact-context {
		padding: var(--spacing-2xl) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.contact-context h2 {
		font-family: var(--font-body);
		font-size: var(--font-size-xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-md);
	}

	.contact-context p {
		max-width: 44rem;
		margin-bottom: var(--spacing-lg);
		line-height: var(--leading-relaxed);
	}
	.contact-info {
		margin-top: var(--spacing-2xl);
		border-top: 1px solid var(--color-border);
	}

	.info-section {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: var(--spacing-lg);
		padding: var(--spacing-lg) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.info-section h2 {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		font-weight: 700;
	}

	.info-section p,
	.info-section a,
	.profile-links {
		font-size: var(--font-size-base);
		color: var(--color-muted);
	}

	.info-section a {
		color: var(--color-brand);
		text-underline-offset: 0.2em;
	}

	.profile-links {
		list-style: none;
		display: flex;
		gap: var(--spacing-lg);
	}

	@media (max-width: 768px) {
		.contact-page {
			padding-top: var(--spacing-xl);
		}

		.contact-title {
			font-size: var(--font-size-3xl);
		}
	}

	@media (max-width: 480px) {
		.info-section {
			grid-template-columns: 1fr;
			gap: var(--spacing-sm);
		}
	}
</style>
