---
import Base from "../layouts/Base.astro";
import { markdownResponse } from "../lib/markdown";

const markdown = `# Page not found

The requested page does not exist on Alejandro Ramírez's portfolio.

## Where to look next

- [Home](https://soyalejo.com/): Professional summary and selected work.
- [Technical tutorials](https://soyalejo.com/work): Automation, accounting, integration, and open-source work.
- [About](https://soyalejo.com/about): Background, methods, and current focus.
- [Contact](https://soyalejo.com/contact): Professional contact details.
- [Agent guide](https://soyalejo.com/llms.txt): When to use this site and which pages answer specific questions.
`;

Astro.response.status = 404;

const markdownPage = Astro.locals.prefersMarkdown ? markdownResponse(markdown, 404) : null;
if (markdownPage) return markdownPage;
---

<Base title="Page not found">
	<div class="not-found">
		<span class="not-found-code">404</span>
		<h1>Page not found</h1>
		<p>The page you're looking for doesn't exist or has been moved.</p>
		<p class="not-found-help">
			Use the <a href="/work">technical tutorials</a>, <a href="/about">about page</a>,
			<a href="/contact">contact page</a>, or the <a href="/llms.txt">agent guide</a> to find
			the right information.
		</p>
		<div class="not-found-links">
			<a href="/" class="link-primary">Go home</a>
			<a href="/work" class="link-secondary">View technical tutorials</a>
		</div>
	</div>
</Base>

<style>
	.not-found {
		text-align: center;
		padding: var(--spacing-4xl) var(--spacing-lg);
		max-width: 52rem;
		margin: 0 auto;
	}

	.not-found-code {
		display: block;
		font-family: var(--font-body);
		font-size: 8rem;
		font-weight: 700;
		line-height: 1;
		color: var(--color-surface);
		margin-bottom: var(--spacing-lg);
	}

	.not-found h1 {
		font-family: var(--font-body);
		font-size: var(--font-size-2xl);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-sm);
	}

	.not-found p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-2xl);
	}

	.not-found-help {
		max-width: 38rem;
		margin-inline: auto;
	}

	.not-found-links {
		display: flex;
		gap: var(--spacing-md);
		justify-content: center;
	}

	.link-primary {
		padding: var(--spacing-sm) var(--spacing-lg);
		font-size: var(--font-size-sm);
		color: var(--color-on-brand);
		background: var(--color-brand);
		text-decoration: none;
	}

	.link-primary:hover {
		transform: translateY(-2px);
	}

	.link-secondary {
		padding: var(--spacing-sm) var(--spacing-lg);
		font-size: var(--font-size-sm);
		color: var(--color-text);
		text-decoration: none;
		border: 1px solid var(--color-border);
	}

	.link-secondary:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
		transform: translateY(-2px);
	}

	@media (max-width: 480px) {
		.not-found-code {
			font-size: 5rem;
		}

		.not-found-links {
			flex-direction: column;
		}
	}
</style>
