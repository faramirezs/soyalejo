---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	variant?: "default" | "paper";
}

const { title, description, image, type = "website", variant = "paper" } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "Studio";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = settings?.tagline || "Design & Development";
const siteLogo = (settings?.logo as any)?.url ? settings.logo as
	{ mediaId: string; alt?: string; url: string } : null;

const menu = await getMenu("primary");

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-app" preload />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body class:list={{ "paper-shell": variant === "paper" }}>
		{
			variant === "paper" && (
				<a class="skip-link" href="#main-content">Skip to content</a>
			)
		}
		<header class="site-header">
			<nav class="nav">
				<a href="/" class="site-title">
					{siteLogo
						? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo-img" />
						: siteTitle
					}
				</a>
				<div class="nav-links">
					{
						menu?.items.map((item) => (
							<a href={item.url} target={item.target}>
								{item.label}
							</a>
						))
					}
				</div>
				<button type="button" class="theme-toggle" aria-label="Switch to dark theme">
					Dark
				</button>
			</nav>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-content">
				<div class="footer-brand">
					<span class="footer-logo">
						{siteLogo
							? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="footer-logo-img" />
							: siteTitle
						}
					</span>
					<p class="footer-tagline">
						{settings?.tagline || "Design & Development"}
					</p>
				</div>
				<div class="footer-right">
					<p class="footer-powered">
						Powered by <a href="https://emdashcms.com">EmDash</a>
					</p>
				</div>
			</div>
		</footer>

		<script>
			const THEME_REGEX = /theme=([^;]+)/;
			const root = document.documentElement;
			const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");

			function resolvedTheme(): "light" | "dark" {
				if (root.classList.contains("dark")) return "dark";
				if (root.classList.contains("light")) return "light";
				return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			function updateThemeToggle() {
				if (!themeToggle) return;
				const nextTheme = resolvedTheme() === "dark" ? "light" : "dark";
				themeToggle.textContent = nextTheme === "dark" ? "Dark" : "Light";
				themeToggle.setAttribute("aria-label", `Switch to ${nextTheme} theme`);
			}

			function setTheme(theme: "light" | "dark") {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`;
				root.classList.remove("light", "dark");
				root.classList.add(theme);
				updateThemeToggle();
			}

			const storedTheme = document.cookie.match(THEME_REGEX)?.[1];
			if (storedTheme === "light" || storedTheme === "dark") {
				setTheme(storedTheme);
			} else {
				updateThemeToggle();
			}

			themeToggle?.addEventListener("click", () => {
				setTheme(resolvedTheme() === "dark" ? "light" : "dark");
			});
		</script>

		<style is:global>
			/*
			 * Establish layer order: "base" has lower priority than unlayered
			 * styles, so theme.css overrides always win regardless of source
			 * order in the bundled CSS.
			 */
			@layer base;

			@layer base {
				*,
				*::before,
				*::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				/*
				 * Design tokens live in src/styles/tokens.css. Colors are
				 * defined with light-dark(); these rules pin the scheme when
				 * the footer switcher sets an explicit choice. With no class,
				 * color-scheme: light dark follows the OS preference. The
				 * @supports guard keeps the toggle from forcing dark UA form
				 * controls on browsers stuck on the plain-light fallback.
				 */
				@supports (color: light-dark(#000, #fff)) {
					:root.light {
						color-scheme: light;
					}

					:root.dark {
						color-scheme: dark;
					}
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-normal);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a {
					color: currentColor;
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4 {
					font-family: var(--font-heading);
					font-weight: var(--font-weight-heading);
					line-height: var(--leading-snug);
				}

				h1 {
					font-size: var(--font-size-4xl);
				}

				h2 {
					font-size: var(--font-size-2xl);
				}

				h3 {
					font-size: var(--font-size-xl);
				}
			}
		</style>

		<style>
			.site-header {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-xl) var(--spacing-lg);
			}

			.nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
			}

			.site-title {
				font-family: var(--font-heading);
				font-size: var(--font-size-lg);
				font-weight: 600;
				text-decoration: none;
				letter-spacing: var(--tracking-tight);
			}

			.site-logo-img {
				height: 48px;
				width: auto;
				display: block;
				margin: -8px 0;
			}

			.nav-links {
				display: flex;
				gap: var(--spacing-xl);
				font-size: var(--font-size-sm);
			}

			.nav-links a {
				text-decoration: none;
				color: var(--color-muted);
				transition: color var(--transition-fast);
			}

			.nav-links a:hover {
				color: var(--color-text);
			}

			.nav-links a:empty {
				display: none;
			}

			.nav-admin {
				opacity: 0.5;
			}

			main {
				min-height: calc(100vh - 200px);
			}

			.site-footer {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-3xl) var(--spacing-lg);
				border-top: 1px solid var(--color-border);
			}

			.footer-content {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
			}

			.footer-logo {
				font-family: var(--font-heading);
				font-size: var(--font-size-lg);
				font-weight: 600;
			}

			.footer-logo-img {
				height: 24px;
				width: auto;
			}

			.footer-tagline {
				font-family: var(--font-heading);
				font-style: italic;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-xs);
			}

			.footer-right {
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: var(--spacing-md);
			}

			.footer-powered {
				font-size: var(--font-size-sm);
				color: var(--color-muted);
			}

			.footer-powered a {
				color: var(--color-text);
				text-decoration: none;
			}

			.footer-powered a:hover {
				text-decoration: underline;
			}


			.paper-shell .skip-link {
				position: fixed;
				top: var(--spacing-sm);
				left: var(--spacing-sm);
				z-index: 1;
				padding: var(--spacing-sm) var(--spacing-md);
				background: var(--color-text);
				color: var(--color-bg);
				text-decoration: none;
				transform: translateY(-200%);
			}

			.paper-shell .skip-link:focus {
				transform: translateY(0);
			}

			.paper-shell .site-header,
			.paper-shell .site-footer {
				max-width: 52rem;
			}

			.paper-shell .site-header {
				padding-top: var(--spacing-lg);
				padding-bottom: var(--spacing-lg);
				border-bottom: 1px solid var(--color-border);
			}

			.paper-shell .nav {
				display: grid;
				grid-template-columns: 1fr auto 1fr;
			}

			.paper-shell .site-title {
				font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
				font-size: var(--font-size-base);
				font-weight: 700;
			}

			.paper-shell .nav-links {
				grid-column: 2;
				gap: var(--spacing-lg);
				font-weight: 600;
			}

			.paper-shell .theme-toggle {
				grid-column: 3;
				justify-self: end;
				border: 0;
				background: transparent;
				color: var(--color-muted);
				font: inherit;
				font-size: var(--font-size-sm);
				font-weight: 600;
				padding: var(--spacing-xs);
			}

			.paper-shell .theme-toggle:hover {
				color: var(--color-brand);
			}

			.paper-shell .site-footer {
				padding-top: var(--spacing-xl);
				padding-bottom: var(--spacing-xl);
			}

			.paper-shell .footer-tagline,
			.paper-shell .footer-powered {
				font-size: var(--font-size-xs);
			}

			@media (max-width: 640px) {
				.nav {
					flex-direction: column;
					gap: var(--spacing-md);
					align-items: center;
				}

				.nav-links {
					flex-wrap: wrap;
					justify-content: center;
				}

				.footer-content {
					flex-direction: column;
					gap: var(--spacing-xl);
					align-items: center;
					text-align: center;
				}

				.footer-right {
					align-items: center;
				}

				.paper-shell .nav {
					display: flex;
				}

				.paper-shell .nav-links {
					grid-column: auto;
				}

				.paper-shell .theme-toggle {
					grid-column: auto;
				}

				h1 {
					font-size: var(--font-size-3xl);
				}
			}
		</style>
	</body>
</html>
